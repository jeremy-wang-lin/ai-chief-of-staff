# SQLite database path (default: ~/.lcos/data.db)
LCOS_DB_PATH=

# Backup directory used when `pnpm lcos backup` has no --dest
LCOS_BACKUP_DIR=

# Web server port (default: 4700)
LCOS_PORT=

# Bind address (default: 127.0.0.1). Non-loopback values require LCOS_TOKEN.
LCOS_HOST=

# Bearer token for /api/*. Generate a fixed value with `openssl rand -hex 32`.
LCOS_TOKEN=

# Additional allowed hostnames in non-loopback mode, comma-separated without ports
LCOS_ALLOWED_HOSTS=

# Optional read-only Jira connector
JIRA_BASE_URL=
JIRA_TOKEN=
JIRA_PROJECTS=
